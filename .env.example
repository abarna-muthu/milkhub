# MilkHub CRM Root Environment Example

# Backend configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=milkhub_tidb_crm_production_secret_key_change_in_prod

# TiDB Database Configuration
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=milkhub
DB_SSL=true

# Alternative single connection string:
# DATABASE_URL=mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/milkhub?ssl={"rejectUnauthorized":true}

# Initial Owner Admin Seed
DEFAULT_OWNER_EMAIL=milkhub@admin.com
DEFAULT_OWNER_PASSWORD=Admin@123

# Frontend (Client) configuration
VITE_API_URL=http://localhost:5000
