# MilkHub CRM Backend Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret for Cryptographic Token Signing
JWT_SECRET=milkhub_tidb_crm_production_secret_key_change_in_prod

# TiDB Database Connection (TiDB Cloud / Local TiDB / MySQL)
# Option 1: Direct parameters
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_user
DB_PASSWORD=your_tidb_password
DB_NAME=milkhub
DB_SSL=true

# Option 2: Full Connection String (if provided by TiDB Cloud console)
# DATABASE_URL=mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/milkhub?ssl={"rejectUnauthorized":true}

# Default Initial Owner Credentials (seeded on first boot if users table is empty)
DEFAULT_OWNER_EMAIL=admin@milkhub.com
DEFAULT_OWNER_PASSWORD=@MilkHub#123
